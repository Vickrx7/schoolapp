-- Shared helpers for the pgTAP suite. Included with \ir at the top of each test file,
-- inside the test's transaction, so everything here is rolled back afterwards.
-- (The .psql extension keeps pg_prove from running this file as a test on its own.)

create extension if not exists pgtap with schema extensions;
set search_path = public, extensions;

create schema tests;
grant usage on schema tests to anon, authenticated;

create table tests.ids (key text primary key, id uuid not null);
grant select, insert on tests.ids to anon, authenticated;

-- Volatile on purpose: the planner pre-evaluates stable functions with an older snapshot.
create function tests.id(p_key text)
returns uuid
language plpgsql
volatile
as $$
declare
  v_id uuid;
begin
  select id into v_id from tests.ids where key = p_key;
  if v_id is null then
    raise exception 'unknown test id: %', p_key;
  end if;
  return v_id;
end;
$$;

create function tests.remember(p_key text, p_id uuid)
returns uuid
language sql
as $$
  insert into tests.ids (key, id) values (p_key, p_id) returning id;
$$;

create function tests.create_user(p_key text)
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
  v_email text := replace(p_key, '_', '.') || '@test.lynx.test';
begin
  insert into auth.users (instance_id, id, aud, role, email, email_confirmed_at, raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values ('00000000-0000-0000-0000-000000000000', v_id, 'authenticated', 'authenticated', v_email, now(), '{}', '{}', now(), now());
  insert into public.users (id, email, display_name) values (v_id, v_email, p_key);
  return tests.remember(p_key, v_id);
end;
$$;

create function tests.authenticate_as(p_key text)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', tests.id(p_key), 'role', 'authenticated')::text, true);
  perform set_config('request.jwt.claim.sub', tests.id(p_key)::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create function tests.authenticate_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role": "anon"}', true);
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('role', 'anon', true);
end;
$$;

create function tests.clear_authentication()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'none', true);
  perform set_config('request.jwt.claims', '', true);
  perform set_config('request.jwt.claim.sub', '', true);
end;
$$;

-- The first weekday (Monday to Friday) on or after current_date + p_offset.
create function tests.school_day(p_offset integer)
returns date
language sql
as $$
  select current_date + p_offset + i
  from generate_series(0, 6) as i
  where extract(isodow from current_date + p_offset + i) < 6
  order by i
  limit 1;
$$;

-- A minimal plan the database accepts (schemaVersion 1 and its date). The database never reads
-- anything else in it (D-048).
create function tests.plan_json(p_date date)
returns jsonb
language sql
as $$
  select jsonb_build_object(
    'schemaVersion', 1, 'date', p_date, 'part', 'full_day',
    'classes', '[]'::jsonb, 'groups', '[]'::jsonb, 'dayEvents', '[]'::jsonb, 'blocks', '[]'::jsonb,
    'classNotes', '[]'::jsonb, 'warnings', '[]'::jsonb
  );
$$;

-- The `p_plans` argument of publish_absence and friends: one minimal plan per date, each
-- covering the given classes.
create function tests.plan_items(p_dates date[], p_class_ids uuid[])
returns jsonb
language sql
as $$
  select coalesce(jsonb_agg(jsonb_build_object(
      'date', d, 'classIds', to_jsonb(coalesce(p_class_ids, '{}')), 'plan', tests.plan_json(d))
    order by d), '[]'::jsonb)
  from unnest(p_dates) as d;
$$;

-- The substitute portal's database role (it has no JWT claims).
create function tests.as_portal()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '', true);
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('role', 'lynx_sub_portal', true);
end;
$$;

grant execute on all functions in schema tests to anon, authenticated;

-- Standard fixture: two boards, three schools, one person per role, three classes.
create function tests.build_fixture()
returns void
language plpgsql
as $$
declare
  v_fra uuid := (select id from public.subjects where code = 'fra' and board_id is null);
  v_mat uuid := (select id from public.subjects where code = 'mat' and board_id is null);
begin
  perform tests.remember('board_a', gen_random_uuid());
  perform tests.remember('board_b', gen_random_uuid());
  insert into public.boards (id, name, slug) values
    (tests.id('board_a'), 'Board A', 'board-a-' || substr(tests.id('board_a')::text, 1, 8)),
    (tests.id('board_b'), 'Board B', 'board-b-' || substr(tests.id('board_b')::text, 1, 8));
  perform public.provision_board_defaults(tests.id('board_a'));
  perform public.provision_board_defaults(tests.id('board_b'));

  perform tests.remember('school_a1', gen_random_uuid());
  perform tests.remember('school_a2', gen_random_uuid());
  perform tests.remember('school_b1', gen_random_uuid());
  insert into public.schools (id, board_id, name, slug, student_alerts_enabled) values
    (tests.id('school_a1'), tests.id('board_a'), 'School A1', 'a1', true),
    (tests.id('school_a2'), tests.id('board_a'), 'School A2', 'a2', false),
    (tests.id('school_b1'), tests.id('board_b'), 'School B1', 'b1', true);
  -- Pilot modules (core, teaching, library), as for a real school. Valid from yesterday: the
  -- server's date can be a day ahead of the schools' local date in the evening.
  perform public.provision_school_defaults(tests.id('school_a1'));
  perform public.provision_school_defaults(tests.id('school_a2'));
  perform public.provision_school_defaults(tests.id('school_b1'));
  update public.module_entitlements set valid_from = current_date - 1
  where school_id in (tests.id('school_a1'), tests.id('school_a2'), tests.id('school_b1'));

  perform tests.remember('year_a', gen_random_uuid());
  perform tests.remember('year_b', gen_random_uuid());
  insert into public.school_years (id, board_id, name, starts_on, ends_on) values
    (tests.id('year_a'), tests.id('board_a'), '2026-2027', '2026-09-01', '2027-06-30'),
    (tests.id('year_b'), tests.id('board_b'), '2026-2027', '2026-09-01', '2027-06-30');

  perform tests.create_user('teacher_a');
  perform tests.create_user('teacher_a_other');
  perform tests.create_user('subject_teacher');
  perform tests.create_user('principal_a');
  perform tests.create_user('office_a');
  perform tests.create_user('principal_a2');
  perform tests.create_user('board_admin_a');
  perform tests.create_user('teacher_b');
  perform tests.create_user('former_teacher');
  perform tests.create_user('outsider');

  insert into public.user_roles (user_id, role, board_id, school_id) values
    (tests.id('teacher_a'), 'teacher', tests.id('board_a'), tests.id('school_a1')),
    (tests.id('teacher_a_other'), 'teacher', tests.id('board_a'), tests.id('school_a1')),
    (tests.id('subject_teacher'), 'teacher', tests.id('board_a'), tests.id('school_a1')),
    (tests.id('principal_a'), 'principal', tests.id('board_a'), tests.id('school_a1')),
    (tests.id('office_a'), 'office_admin', tests.id('board_a'), tests.id('school_a1')),
    (tests.id('principal_a2'), 'principal', tests.id('board_a'), tests.id('school_a2')),
    (tests.id('board_admin_a'), 'board_admin', tests.id('board_a'), null),
    (tests.id('teacher_b'), 'teacher', tests.id('board_b'), tests.id('school_b1')),
    (tests.id('former_teacher'), 'teacher', tests.id('board_a'), tests.id('school_a1'));
  update public.users set deactivated_at = now() where id = tests.id('former_teacher');

  perform tests.remember('class_a', gen_random_uuid());
  perform tests.remember('class_a_other', gen_random_uuid());
  perform tests.remember('class_b', gen_random_uuid());
  insert into public.classes (id, school_id, school_year_id, name) values
    (tests.id('class_a'), tests.id('school_a1'), tests.id('year_a'), 'Class A'),
    (tests.id('class_a_other'), tests.id('school_a1'), tests.id('year_a'), 'Class A other'),
    (tests.id('class_b'), tests.id('school_b1'), tests.id('year_b'), 'Class B');
  insert into public.class_grades (class_id, grade_code) values
    (tests.id('class_a'), '3'), (tests.id('class_a_other'), '5'), (tests.id('class_b'), '3');
  insert into public.class_teachers (class_id, user_id, role) values
    (tests.id('class_a'), tests.id('teacher_a'), 'homeroom'),
    (tests.id('class_a'), tests.id('subject_teacher'), 'subject'),
    (tests.id('class_a_other'), tests.id('teacher_a_other'), 'homeroom'),
    (tests.id('class_a_other'), tests.id('former_teacher'), 'subject'),
    (tests.id('class_b'), tests.id('teacher_b'), 'homeroom');

  perform tests.remember('student_a1', gen_random_uuid());
  perform tests.remember('student_a2', gen_random_uuid());
  perform tests.remember('student_a_other', gen_random_uuid());
  perform tests.remember('student_b', gen_random_uuid());
  insert into public.students (id, class_id, first_name) values
    (tests.id('student_a1'), tests.id('class_a'), 'Léa'),
    (tests.id('student_a2'), tests.id('class_a'), 'Nathan'),
    (tests.id('student_a_other'), tests.id('class_a_other'), 'Zoé'),
    (tests.id('student_b'), tests.id('class_b'), 'Adam');

  insert into public.timetable_blocks (class_id, day_key, start_time, end_time, kind, subject_id) values
    (tests.id('class_a'), 1, '08:55', '09:45', 'subject', v_fra),
    (tests.id('class_a_other'), 1, '08:55', '09:45', 'subject', v_mat),
    (tests.id('class_b'), 1, '08:55', '09:45', 'subject', v_fra);

  perform tests.remember('unit_a', gen_random_uuid());
  perform tests.remember('unit_b', gen_random_uuid());
  insert into public.units (id, class_id, subject_id, title, status) values
    (tests.id('unit_a'), tests.id('class_a'), v_fra, 'Unit A', 'active'),
    (tests.id('unit_b'), tests.id('class_b'), v_fra, 'Unit B', 'active');

  perform tests.remember('lesson_a1', gen_random_uuid());
  perform tests.remember('lesson_a2', gen_random_uuid());
  perform tests.remember('lesson_a3', gen_random_uuid());
  perform tests.remember('lesson_b1', gen_random_uuid());
  insert into public.unit_lessons (id, unit_id, sequence_number, title) values
    (tests.id('lesson_a1'), tests.id('unit_a'), 1, 'Lesson A1'),
    (tests.id('lesson_a2'), tests.id('unit_a'), 2, 'Lesson A2'),
    (tests.id('lesson_a3'), tests.id('unit_a'), 3, 'Lesson A3'),
    (tests.id('lesson_b1'), tests.id('unit_b'), 1, 'Lesson B1');

  delete from public.event_outbox;
end;
$$;

-- Library fixture (Phase 4), on top of build_fixture(): reviewers designated by board A, test
-- attentes, tags, Catholic references and a personal level.
--   board_admin_a     content reviewer of board A (only content)
--   faith_reviewer_a  teacher at school_a2, faith reviewer of board A (only faith)
--   exp_a_parent      Français, 3e, overall (T1); exp_a its specific attente (T1.2)
--   exp_other         Mathématiques, 5e (T9)
--   tag_global (every board), tag_b (board B); ref_a (board A), ref_b (board B)
--   level_personal_a  teacher_a's own language level
create function tests.build_library_fixture()
returns void
language plpgsql
as $$
declare
  v_fra uuid := (select id from public.subjects where code = 'fra' and board_id is null);
  v_mat uuid := (select id from public.subjects where code = 'mat' and board_id is null);
begin
  insert into public.library_reviewers (board_id, user_id, approves_content, reviews_faith)
  values (tests.id('board_a'), tests.id('board_admin_a'), true, false);
  perform tests.create_user('faith_reviewer_a');
  insert into public.user_roles (user_id, role, board_id, school_id)
  values (tests.id('faith_reviewer_a'), 'teacher', tests.id('board_a'), tests.id('school_a2'));
  insert into public.library_reviewers (board_id, user_id, approves_content, reviews_faith)
  values (tests.id('board_a'), tests.id('faith_reviewer_a'), false, true);

  insert into public.curriculum_expectations (id, subject_id, grade_code, parent_id, kind, code,
    text_fr, curriculum_version) values
    (tests.remember('exp_a_parent', gen_random_uuid()), v_fra, '3', null, 'overall', 'T1',
     'Lire des textes variés pour s''informer.', 'test');
  insert into public.curriculum_expectations (id, subject_id, grade_code, parent_id, kind, code,
    text_fr, curriculum_version) values
    (tests.remember('exp_a', gen_random_uuid()), v_fra, '3', tests.id('exp_a_parent'), 'specific',
     'T1.2', 'Dégager l''idée principale d''un texte informatif.', 'test'),
    (tests.remember('exp_other', gen_random_uuid()), v_mat, '5', null, 'overall', 'T9',
     'Comparer des fractions.', 'test');

  insert into public.tags (id, board_id, slug, label_fr) values
    (tests.remember('tag_global', gen_random_uuid()), null, 'test-global-' || substr(md5(random()::text), 1, 8), 'Étiquette de test'),
    (tests.remember('tag_b', gen_random_uuid()), tests.id('board_b'), 'test-b', 'Étiquette B');

  insert into public.catholic_references (id, board_id, type, title, text_fr) values
    (tests.remember('ref_a', gen_random_uuid()), tests.id('board_a'), 'virtue', 'Le respect',
     'Respecter chaque personne.'),
    (tests.remember('ref_b', gen_random_uuid()), tests.id('board_b'), 'virtue', 'La paix',
     'Chercher la paix.');

  insert into public.language_levels (id, board_id, owner_user_id, code, label_fr)
  values (tests.remember('level_personal_a', gen_random_uuid()), tests.id('board_a'),
    tests.id('teacher_a'), 'perso_test', 'Mon niveau');
end;
$$;

-- An active board level of a board, by code (debutant, intermediaire, avance, enrichi).
create function tests.board_level(p_board text, p_code text)
returns uuid
language sql
as $$
  select id from public.language_levels
  where board_id = tests.id(p_board) and owner_user_id is null and code = p_code;
$$;

-- A save_library_item payload for a ready item of board A (school_a1): 3e année, Français,
-- exp_a, materials, a keyword, a base version, and an empty key for types that need one. Tests
-- change it with ||, jsonb_set or `- key`.
create function tests.library_payload(
  p_type text,
  p_title text,
  p_board text default 'board_a',
  p_school text default 'school_a1'
)
returns jsonb
language sql
as $$
  select jsonb_build_object(
    'boardId', tests.id(p_board), 'schoolId', tests.id(p_school), 'type', p_type,
    'title', p_title, 'summary', 'Une ressource de test.', 'licence', null,
    'subjectId', (select id from public.subjects where code = 'fra' and board_id is null),
    'durationMinutes', 30, 'materials', 'Crayons et feuilles', 'keywords', 'lecture huard',
    'isPrintable', true, 'isProjectable', false, 'isInteractive', false, 'subFriendly', false,
    'safetyNotes', null, 'faithContent', false, 'faithOnStudentSheet', false,
    'catholicConnection', '', 'catholicReferenceId', null,
    'gradeCodes', jsonb_build_array('3'), 'expectationIds', jsonb_build_array(tests.id('exp_a')),
    'tagIds', jsonb_build_array(tests.id('tag_global')),
    'versions', jsonb_build_array(jsonb_build_object(
      'languageLevelId', null,
      'content', jsonb_build_object('title', '', 'objective', 'Trouver l’idée principale.',
        'teacherNote', '', 'text', 'Le huard vit sur les lacs de l’Ontario.'),
      'answerKey', case when p_type in ('quiz', 'unit_test', 'diagnostic', 'exit_ticket', 'riddle')
        then '{"answers": [], "solution": ""}'::jsonb end)));
$$;

-- Complete safety notes (D-067).
create function tests.safety_notes(p_supervision text default 'standard')
returns jsonb
language sql
as $$
  select jsonb_build_object('ageSuitability', 'De 9 à 11 ans',
    'allergyAwareMaterials', 'Élastiques sans latex', 'supervision', p_supervision,
    'hazards', jsonb_build_array('Ne jamais lancer un élastique'), 'notes', '');
$$;

-- A ready item written directly (as superuser), with the given author (null: a board item),
-- status, scope and school: 3e année, Français, exp_a, materials, a keyword, a base version, a
-- key for keyed types, every board level for the types that need them for approval, safety
-- notes for experiments and STEM challenges. Its title is « Ressource <key> ». A board item (no
-- author) is the board's own (`board_owned`, D-091) unless `p_board_owned` says otherwise.
create function tests.library_item(
  p_key text,
  p_author text,
  p_type public.library_item_type,
  p_status public.library_item_status default 'draft',
  p_scope public.share_scope default 'private',
  p_school text default null,
  p_board text default 'board_a',
  p_board_owned boolean default null
)
returns uuid
language plpgsql
as $$
declare
  v_id uuid := tests.remember(p_key, gen_random_uuid());
  v_keyed boolean := p_type in ('quiz', 'unit_test', 'diagnostic', 'exit_ticket', 'riddle');
  v_version uuid;
  v_level uuid;
begin
  insert into public.library_items (id, board_id, school_id, type, title, status, share_scope,
    source, author_id, board_owned, subject_id, duration_minutes, materials, keywords,
    safety_notes, approved_at)
  values (v_id, tests.id(p_board), case when p_school is not null then tests.id(p_school) end,
    p_type, 'Ressource ' || p_key, p_status, p_scope,
    case when p_author is null then 'board_created' else 'teacher_created' end::public.library_source,
    case when p_author is not null then tests.id(p_author) end,
    coalesce(p_board_owned, p_author is null),
    (select id from public.subjects where code = 'fra' and board_id is null), 30,
    'Crayons et feuilles', 'lecture',
    case when p_type in ('experiment', 'stem_challenge') then tests.safety_notes() end,
    case when p_status = 'board_approved' then now() end);
  insert into public.library_item_grades (item_id, grade_code) values (v_id, '3');
  insert into public.library_item_expectations (item_id, expectation_id) values (v_id, tests.id('exp_a'));
  insert into public.library_item_versions (item_id, language_level_id, content)
  values (v_id, null, jsonb_build_object('title', '', 'objective', 'Trouver l’idée principale.',
    'teacherNote', '', 'text', 'Le huard vit sur les lacs de l’Ontario.'))
  returning id into v_version;
  if v_keyed then
    insert into public.library_item_answer_keys (version_id, answer_key)
    values (v_version, '{"answers": [], "solution": ""}');
  end if;
  if p_type in ('reading_passage', 'worksheet', 'exit_ticket', 'quiz') then
    for v_level in
      select id from public.language_levels
      where board_id = tests.id(p_board) and owner_user_id is null and active
    loop
      insert into public.library_item_versions (item_id, language_level_id, content)
      values (v_id, v_level, jsonb_build_object('title', '', 'objective', 'Trouver l’idée principale.',
        'teacherNote', '', 'text', 'Le huard vit sur les lacs.'))
      returning id into v_version;
      if v_keyed then
        insert into public.library_item_answer_keys (version_id, answer_key)
        values (v_version, '{"answers": [], "solution": ""}');
      end if;
    end loop;
  end if;
  perform app.library_refresh_search(v_id);
  return v_id;
end;
$$;

-- Puts an item in the approval queue, as its author asked (superuser).
create function tests.library_request(p_key text)
returns void
language sql
as $$
  update public.library_items
  set review_requested_at = now(), review_requested_by = author_id
  where id = tests.id(p_key);
$$;

-- The SQLSTATE of a statement run as the current role, followed by the error's detail when it
-- has one (« LXL01 expectations »); null when it succeeds. Its changes are rolled back either way
-- when it fails.
create function tests.error_of(p_sql text)
returns text
language plpgsql
as $$
declare
  v_state text;
  v_detail text;
begin
  execute p_sql;
  return null;
exception when others then
  get stacked diagnostics v_state = returned_sqlstate, v_detail = pg_exception_detail;
  return v_state || coalesce(' ' || nullif(v_detail, ''), '');
end;
$$;

-- A save_library_item payload with one more version, for a level, copied from the base version.
create function tests.with_version(p_payload jsonb, p_level uuid)
returns jsonb
language sql
as $$
  select jsonb_set(p_payload, '{versions}', (p_payload -> 'versions')
    || jsonb_build_array((p_payload -> 'versions' -> 0) || jsonb_build_object('languageLevelId', p_level)));
$$;

-- A save_library_item payload with a version for every active level of a board.
create function tests.with_board_levels(p_payload jsonb, p_board text default 'board_a')
returns jsonb
language sql
as $$
  select jsonb_set(p_payload, '{versions}', (p_payload -> 'versions') || coalesce((
    select jsonb_agg((p_payload -> 'versions' -> 0) || jsonb_build_object('languageLevelId', ll.id)
      order by ll.sort_order)
    from public.language_levels ll
    where ll.board_id = tests.id(p_board) and ll.owner_user_id is null and ll.active), '[]'::jsonb));
$$;
