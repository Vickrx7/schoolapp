{
  "name": "lynx-ecole",
  "private": true,
  "description": "Platform for French-language Catholic elementary schools in Ontario",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @lynx/web dev",
    "dev:worker": "pnpm --filter @lynx/worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "test:e2e": "pnpm --filter @lynx/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts",
    "admin": "pnpm --filter @lynx/admin run cli",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:types:direct": "tsx tools/gen-db-types.ts && prettier --write packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
