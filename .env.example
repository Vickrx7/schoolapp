# ---------------------------------------------------------------------------------------
# Lynx École configuration. Copy to apps/web/.env.local (web app) and export for the worker.
# Every setting is an environment variable so the same build runs hosted or board-hosted.
# ---------------------------------------------------------------------------------------

# --- Supabase (API URL and public "anon" key; RLS protects all data) --------------------
# Local defaults match `supabase start` and tools/lite-stack/stack.sh.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server-only secret. Used by the admin CLI (pnpm admin ...). Never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- App ---------------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
# Working product name shown in the UI (placeholder until a name is chosen).
NEXT_PUBLIC_APP_NAME=Lynx École

# Encryption keys for safety/medical alert text: "version:base64(32 random bytes)",
# comma-separated for rotation (highest version encrypts). Generate one with:
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
# Empty = alerts cannot be recorded. The value below is for LOCAL DEVELOPMENT ONLY.
ALERTS_ENCRYPTION_KEYS=1:ZGV2LW9ubHktYWxlcnQta2V5LWRvLW5vdC11c2UtISE=

# --- Substitute portal (no account: a code from the office or the teacher) ------------------
# Direct database connection as the role lynx_sub_portal, which can only run the portal's
# functions. The password below is set by supabase/seed.sql for LOCAL DEVELOPMENT AND CI ONLY;
# in production set a secret one (docs/phase-3.md). On hosted Supabase the pooler user name is
# lynx_sub_portal.<project-ref>. Empty = substitute access is off on this server.
# (Local fallback if password logins are refused: connect as postgres with
#  ?options=-c%20role%3Dlynx_sub_portal, which the migration allows for the postgres role.)
SUB_PORTAL_DATABASE_URL=postgresql://lynx_sub_portal:lynx-sub-portal-local-only@127.0.0.1:54322/postgres
# Keys for hashing access codes: "version:base64(32 random bytes)", at most two (current and
# previous, comma-separated) during a rotation. Generate one as for ALERTS_ENCRYPTION_KEYS.
# Rotate outside school hours: the per-network throttle counts start again with the new key.
# Empty = codes cannot be issued or used. The value below is for LOCAL DEVELOPMENT ONLY.
SUB_CODE_HMAC_KEYS=1:ZGV2LW9ubHktc3ViLWNvZGUta2V5LWRvLW5vdC11c2U=
# Where the client address comes from, for throttling code attempts per network. In
# production the web server MUST sit behind a reverse proxy that appends the client address to
# X-Forwarded-For (and is the only way in): TRUSTED_PROXY_HOPS is the number of such proxies
# (1: the right-most entry, added by your proxy). Reached directly, a client could write its own
# address there. 0 ignores the header (everyone shares one bucket). See docs/phase-3.md.
CLIENT_IP_HEADER=x-forwarded-for
TRUSTED_PROXY_HOPS=1

# --- Worker (apps/worker) ------------------------------------------------------------------
# Direct Postgres connection (session mode; the worker uses LISTEN/NOTIFY).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
WORKER_CONCURRENCY=4
OUTBOX_BATCH_SIZE=100
# Only "mock" exists in the MVP: no real paging, door, intercom, camera or SMS calls.
INTEGRATIONS_MODE=mock
LOG_EVENTS=true

# AI runs only in the worker. "fake" answers locally (nothing leaves the machine);
# "anthropic" calls Claude and needs ANTHROPIC_API_KEY; "none" turns AI requests off.
# Each school's AI also stays off until its principal turns it on (École page).
AI_PROVIDER=fake
# Never commit a real key. Put it in apps/web/.env.local or your host's secret settings.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Days before AI requests are deleted (usage records are kept).
AI_JOB_RETENTION_DAYS=30
